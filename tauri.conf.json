{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emmu",
  "version": "0.2.0",
  "identifier": "com.emmu.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "../web/ui",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web/ui"
    },
    "frontendDist": "../web/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emmu",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../crates/emmu-mesen-sys/runtime/*": "",
      "../../crates/emmu-n64/vendor/n64wasm/n64wasm.js": "wasm/n64/n64wasm.js",
      "../../crates/emmu-n64/vendor/n64wasm/n64wasm.wasm": "wasm/n64/n64wasm.wasm",
      "../../crates/emmu-n64/vendor/n64wasm/assets.zip": "wasm/n64/assets.zip"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
